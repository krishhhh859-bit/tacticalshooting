{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**,client/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/socket.io(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/((?!api|socket\\.io|client).*)",
      "destination": "/client/$1"
    }
  ]
}
